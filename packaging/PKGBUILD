# Maintainer: Chavindu Jayakody <https://github.com/ChavinduJayakody>
pkgname=netsplit
pkgver=1.3.0
pkgrel=1
pkgdesc="Real-time split VPN / Wi-Fi network traffic monitor with GTK 4 UI"
arch=('x86_64')
url="https://github.com/ChavinduJayakody/NetSplit"
license=('MIT')
depends=(
    'python'
    'python-psutil'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'python-cairo'
)
optdepends=(
    'python-pywebview: web UI / browser panel support'
    'iw: Wi-Fi signal & bitrate info'
    'iputils: ping latency probes'
)
makedepends=('git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ChavinduJayakody/NetSplit/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # updated by CI

prepare() {
    cd "NetSplit-${pkgver}"
}

package() {
    cd "NetSplit-${pkgver}"

    # Install application files
    install -dm755 "${pkgdir}/usr/lib/${pkgname}"
    cp -r core gui web assets main.py "${pkgdir}/usr/lib/${pkgname}/"

    # Launcher script
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/netsplit" << 'EOF'
#!/bin/sh
exec python /usr/lib/netsplit/main.py "$@"
EOF
    chmod +x "${pkgdir}/usr/bin/netsplit"

    # Desktop entry
    install -Dm644 netsplit.desktop \
        "${pkgdir}/usr/share/applications/netsplit.desktop"

    # Fix Exec path in desktop entry for system-wide install
    sed -i 's|^Exec=.*|Exec=/usr/bin/netsplit|' \
        "${pkgdir}/usr/share/applications/netsplit.desktop"

    # Fix Comment to be generic
    sed -i 's|^Comment=.*|Comment=Real-time split VPN / Wi-Fi network traffic monitor|' \
        "${pkgdir}/usr/share/applications/netsplit.desktop"

    # Icons
    install -Dm644 assets/netsplit.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/netsplit.svg"
    install -Dm644 assets/netsplit_256.png \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/netsplit.png"

    # License
    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
